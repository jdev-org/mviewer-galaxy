# Copier ce fichier vers .env sur le poste de contrôle Ansible.
# Valeurs littérales : aucune expansion de variable ni commande shell.
# Avant installation, adapter les IP dans roles/postgres/templates/pg_hba.conf.j2.
POSTGRES_DB=donneessig
POSTGRES_USER=usersig
# Obligatoire : renseigner un mot de passe avant de lancer le rôle postgres.
POSTGRES_PASSWORD=secret
