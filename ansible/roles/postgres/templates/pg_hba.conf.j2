# Géré par Ansible : adapter les IP et réseaux de ce template AVANT l'installation.
# TYPE  DATABASE  USER  ADDRESS  METHOD

# Administration locale et comptes système (conserver l'accès postgres).
local all postgres peer
local all all peer

# Connexion locale de GeoServer à la base SIG.
host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" 127.0.0.1/32 scram-sha-256
host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" ::1/128 scram-sha-256

# Ajouter ici les clients SIG autorisés, AVANT les règles reject.
# host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" 192.0.2.10/32 scram-sha-256
# host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" 10.0.0.0/24 scram-sha-256

# Refuser les autres clients pour ce couple base/utilisateur.
host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" 0.0.0.0/0 reject
host "{{ postgres_configuration.database }}" "{{ postgres_configuration.username }}" ::/0 reject

# Autres connexions et réplication : accès local uniquement.
host all all 127.0.0.1/32 scram-sha-256
host all all ::1/128 scram-sha-256
local replication all peer
host replication all 127.0.0.1/32 scram-sha-256
host replication all ::1/128 scram-sha-256
