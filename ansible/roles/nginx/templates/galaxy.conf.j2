# Géré par Ansible.
server {
    listen {{ nginx_http_port }};
    server_name {{ nginx_server_name }};
    # Conserver le domaine et le port publics, notamment derrière Docker.
    absolute_redirect off;
    client_max_body_size 20m;
    autoindex off;
    access_log {{ nginx_log_dir }}/access.log;
    error_log {{ nginx_log_dir }}/error.log;

{% if galaxy_home_enabled | bool %}
    location = /accueil {
        return 302 /accueil/$is_args$args;
    }

    location /accueil/ {
        alias {{ galaxy_home_dir }}/;
        index index.html;
    }

    location /header/ {
        alias {{ galaxy_header_dir }}/;
    }

    # L'accueil utilise ces chemins absolus depuis / et /accueil/.
    location /assets/ {
        alias {{ galaxy_home_dir }}/assets/;
    }

    location = /config.js {
        alias {{ galaxy_home_dir }}/config.js;
    }

    location = /catalogue {
        return 302 /catalogue/$is_args$args;
    }

    location /catalogue/ {
        alias {{ galaxy_catalogue_dir }}/;
        index index.html;
    }

{% endif %}
    location ~ /\. {
        deny all;
    }

    location = /mviewer {
        return 302 /mviewer/$is_args$args;
    }

    location /mviewer/ {
        alias {{ mviewer_install_dir }}/;
        index index.html;
    }

{% for directory in mviewer_shared_directories %}
    location /mviewer/{{ directory.name }}/ {
        alias {{ directory.path }}/;
    }

    location /{{ directory.name }}/ {
        alias {{ directory.path }}/;
    }

{% endfor %}
    location = /geoserver {
        return 302 {{ galaxy_public_scheme }}://$http_host/geoserver/$is_args$args;
    }

    location /geoserver/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto {{ galaxy_public_scheme }};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        proxy_redirect http://127.0.0.1:{{ geoserver_port }}/ {{ galaxy_public_scheme }}://$http_host/;
        proxy_pass http://127.0.0.1:{{ geoserver_port }};
    }

    location = /{{ mviewerstudio_url_prefix }}/config.json {
        alias {{ mviewerstudio_front_config }};
        default_type application/json;
    }

    location = /{{ mviewerstudio_url_prefix }} {
        return 302 /{{ mviewerstudio_url_prefix }}/$is_args$args;
    }

    location /{{ mviewerstudio_url_prefix }}/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto {{ galaxy_public_scheme }};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_redirect "~^(.*[?&]post_logout_redirect_uri=)[^&]*(.*)$" $1{{ galaxy_public_scheme }}://$http_host{{ galaxy_landing_path }}$2;
        proxy_pass http://127.0.0.1:{{ mviewerstudio_port }};
    }

{% if galaxy_home_enabled | bool %}
    location = /portal/login {
        return 302 /{{ mviewerstudio_url_prefix }}/auth/login?next={{ galaxy_landing_path }};
    }

    location = /portal/logout {
        return 302 /{{ mviewerstudio_url_prefix }}/logout;
    }

    location = /portal/session {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto {{ galaxy_public_scheme }};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_pass http://127.0.0.1:{{ mviewerstudio_port }}/{{ mviewerstudio_url_prefix }}/api/user;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

{% endif %}
    location = / {
        return 302 {{ galaxy_landing_path }};
    }

    location / {
        return 404;
    }
}
