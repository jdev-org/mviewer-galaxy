# Géré par Ansible. Chargé par systemd, sans interpréteur shell.
SECRET_KEY={{ mviewerstudio_secret_key | to_json(ensure_ascii=False) }}
EXPORT_CONF_FOLDER={{ mviewer_store_dir | to_json }}
MVIEWERSTUDIO_PUBLISH_PATH={{ mviewer_public_dir | to_json }}
CONF_PATH_FROM_MVIEWER={{ mviewer_store_name | to_json }}
CONF_PUBLISH_PATH_FROM_MVIEWER={{ mviewer_public_name | to_json }}
DEFAULT_ORG={{ mviewerstudio_default_org | to_json }}
MVIEWERSTUDIO_URL_PATH_PREFIX={{ mviewerstudio_url_prefix | to_json }}
MVIEWERSTUDIO_AUTH_MODE={{ mviewerstudio_auth_mode | to_json }}
{% if mviewerstudio_auth_mode == 'authlib' %}
MVIEWERSTUDIO_AUTHLIB_ISSUER={{ mviewerstudio_oidc_issuer | to_json }}
MVIEWERSTUDIO_AUTHLIB_METADATA_URL={{ mviewerstudio_oidc_metadata_url | to_json }}
MVIEWERSTUDIO_AUTHLIB_CLIENT_ID={{ mviewerstudio_oidc_client_id | to_json }}
MVIEWERSTUDIO_AUTHLIB_CLIENT_SECRET={{ mviewerstudio_oidc_client_secret | to_json(ensure_ascii=False) }}
MVIEWERSTUDIO_AUTHLIB_SCOPE={{ mviewerstudio_oidc_scope | to_json }}
MVIEWERSTUDIO_AUTHLIB_ALLOWED_GROUPS={{ mviewerstudio_oidc_allowed_groups | to_json }}
MVIEWERSTUDIO_AUTHLIB_CLAIMS_MAPPING={{ mviewerstudio_oidc_claims_mapping | to_json | to_json }}
MVIEWERSTUDIO_AUTHLIB_ANONYMOUS_REDIRECT_URL="/mviewer/"
{% endif %}
SESSION_FILE_DIR={{ (galaxy_data_dir ~ '/sessions') | to_json }}
LOG_LEVEL="INFO"
