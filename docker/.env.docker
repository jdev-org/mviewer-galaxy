# Paramètres Docker utilisés par les expressions du Compose.
PROXY_HTTP_PORT=80
MVIEWERSTUDIO_UID=1000
MVIEWERSTUDIO_GID=1000

# Dossiers partagés sur l'hôte (chemins relatifs à docker/ ou absolus).
MVIEWER_APPS_PATH=../resources/mviewer/apps
MVIEWER_STORE_PATH=../resources/mviewer/store
MVIEWER_PUBLIC_PATH=../resources/mviewer/public
