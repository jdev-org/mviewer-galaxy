server {
    listen 80;
    server_name ${NGINX_HOST};

    client_max_body_size 20m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location = /mviewer {
        return 302 /mviewer/$is_args$args;
    }

    location /mviewer/ {
        proxy_set_header sec-username $http_sec_username;
        proxy_set_header sec-firstname $http_sec_firstname;
        proxy_set_header sec-lastname $http_sec_lastname;
        proxy_set_header sec-org $http_sec_org;
        proxy_set_header sec-roles $http_sec_roles;

        proxy_pass http://mviewer:8080/;
    }

    location /apps/ {
        alias /usr/share/nginx/html/apps/;
    }

    location = /${MVIEWERSTUDIO_URL_PATH_PREFIX} {
        return 302 /${MVIEWERSTUDIO_URL_PATH_PREFIX}/$is_args$args;
    }

    location /${MVIEWERSTUDIO_URL_PATH_PREFIX}/ {
        proxy_set_header sec-username $http_sec_username;
        proxy_set_header sec-firstname $http_sec_firstname;
        proxy_set_header sec-lastname $http_sec_lastname;
        proxy_set_header sec-org $http_sec_org;
        proxy_set_header sec-roles $http_sec_roles;

        proxy_pass http://mviewerstudio:8000/${MVIEWERSTUDIO_URL_PATH_PREFIX}/;
    }

    location / {
        return 302 /${MVIEWERSTUDIO_URL_PATH_PREFIX}/;
    }
}
