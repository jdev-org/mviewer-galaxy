server {
    listen 80;
    server_name ${NGINX_HOST};

    resolver 127.0.0.11 ipv6=off;

    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    large_client_header_buffers 4 32k;

    client_max_body_size 20m;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    location = /geoserver {
        return 301 /geoserver/;
    }

    location /geoserver/ {
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  80;
        proxy_set_header X-Forwarded-Prefix /geoserver;

        proxy_redirect http://geoserver:8080/geoserver/ /geoserver/;
        proxy_redirect /geoserver/ /geoserver/;

        proxy_cookie_path /geoserver /geoserver;
        proxy_cookie_path / /geoserver/;

        proxy_pass http://geoserver:8080;
    }

    location = /keycloak {
        return 302 /keycloak/;
    }

    location /keycloak/ {
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  80;
        proxy_set_header X-Forwarded-Prefix /keycloak;

        proxy_pass http://keycloak:8080;
    }

    location / {
        return 302 /geoserver/;
    }
}