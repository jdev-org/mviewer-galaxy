PROXY_HTTP_PORT=80
NGINX_HOST=host.docker.internal

USER_HOME=/home/mvuser
STORE_NAME=store
PUBLIC_NAME=public
MVIEWERSTUDIO_URL_PATH_PREFIX=mviewerstudio
MVIEWERSTUDIO_DEFAULT_ORG=public
MVIEWERSTUDIO_AUTH_ALLOWED_ROLES=MVIEWER_ACCESS
MVIEWER_STORE_PATH=apps/${STORE_NAME:-store}
MVIEWER_PUBLIC_PATH=apps/${PUBLIC_NAME:-public}

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=http://host.docker.internal/keycloak

OAUTH2_PROXY_CLIENT_ID=mviewerstudio
OAUTH2_PROXY_CLIENT_SECRET=mviewerstudio-local-secret
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef
OAUTH2_PROXY_SCOPE=openid email profile organization roles
OAUTH2_PROXY_OIDC_ISSUER_URL=http://host.docker.internal/keycloak/realms/mviewer
OAUTH2_PROXY_LOGIN_URL=http://host.docker.internal/keycloak/realms/mviewer/protocol/openid-connect/auth
OAUTH2_PROXY_REDIRECT_URL=http://host.docker.internal/oauth2/callback
OAUTH2_PROXY_ALLOWED_ROLE=mviewerstudio:MVIEWER_ACCESS
OAUTH2_PROXY_REDEEM_URL=http://keycloak:8080/keycloak/realms/mviewer/protocol/openid-connect/token
OAUTH2_PROXY_OIDC_JWKS_URL=http://keycloak:8080/keycloak/realms/mviewer/protocol/openid-connect/certs
OAUTH2_PROXY_VALIDATE_URL=http://keycloak:8080/keycloak/realms/mviewer/protocol/openid-connect/userinfo
OAUTH2_PROXY_WHITELIST_DOMAIN=host.docker.internal

GEOSERVER_PROXY_BASE_URL=http://host.docker.internal/geoserver
